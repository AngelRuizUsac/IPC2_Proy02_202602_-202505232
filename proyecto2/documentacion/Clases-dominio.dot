digraph Dominio {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.5", fontname="Arial"];
  node [shape=record, fontname="Arial", fontsize=11, style=filled, fillcolor="#f1f4eb", color="#53634c", margin="0.12"];
  edge [fontname="Arial", fontsize=9, color="#596953"];
  { rank=same; ArbolCategorias; ArbolLibros; ArbolTitulos; }
  { rank=same; Categoria; NodoLibro; ListaLibros; }
  Catalogo [label="{Catalogo|+ Categorias: ArbolCategorias\l+ Libros: ArbolLibros\l- titulos: ArbolTitulos\l|+ RegistrarLibro(...)\l+ EliminarLibro(isbn)\l+ BuscarLibro(isbn)\l+ BuscarTitulo(titulo)\l}"];
  Categoria [label="{Categoria|+ Nombre: string\l+ Padre: Categoria?\l+ PrimerHijo: Categoria?\l+ SiguienteHermano: Categoria?\l+ Libros: ArbolLibros\l}"];
  ArbolCategorias [label="{ArbolCategorias|+ PrimeraRaiz: Categoria?\l|+ Agregar(nombre, padre)\l+ Buscar(nombre)\l+ Listar(): ListaCategorias\l}"];
  ArbolLibros [label="{ArbolLibros|+ Raiz: NodoLibro?\l|+ Insertar(libro)\l+ Eliminar(isbn)\l+ Buscar(isbn)\l+ ObtenerMenor() / ObtenerMayor()\l+ ListarPorISBN(): ListaLibros\l}"];
  ArbolTitulos [label="{ArbolTitulos|+ Raiz: NodoLibro?\l|+ Insertar(libro)\l+ Eliminar(libro)\l+ Buscar(titulo): ListaLibros\l}"];
  NodoLibro [label="{NodoLibro|+ Libro: Libro\l+ Izquierdo: NodoLibro?\l+ Derecho: NodoLibro?\l+ Altura: int\l}"];
  Libro [label="{Libro|+ ISBN: long\l+ Titulo: string\l+ Autor: string\l+ Categoria: Categoria\l}"];
  ListaLibros [label="{ListaLibros|+ Primero: NodoListaLibro?\l- ultimo: NodoListaLibro?\l|+ Agregar(libro)\l}"];
  NodoListaLibro [label="{NodoListaLibro|+ Libro: Libro\l+ Siguiente: NodoListaLibro?\l}"];
  Catalogo -> ArbolCategorias [label="1", arrowtail=diamond, dir=both];
  Catalogo -> ArbolLibros [label="global", arrowtail=diamond, dir=both];
  Catalogo -> ArbolTitulos [label="1", arrowtail=diamond, dir=both];
  ArbolCategorias -> Categoria [label="0..*", arrowtail=diamond, dir=both];
  Categoria -> ArbolLibros [label="1 por categoría"];
  Categoria -> Categoria [label="padre / hijo / hermano"];
  ArbolLibros -> NodoLibro [label="0..*", arrowtail=diamond, dir=both];
  ArbolTitulos -> NodoLibro [label="nodos propios", arrowtail=diamond, dir=both];
  NodoLibro -> Libro [label="1"];
  Libro -> Categoria [label="1"];
  ListaLibros -> NodoListaLibro [label="0..*", arrowtail=diamond, dir=both];
  NodoListaLibro -> Libro [label="1"];
  ArbolLibros -> ListaLibros [style=dashed, label="devuelve"];
}
