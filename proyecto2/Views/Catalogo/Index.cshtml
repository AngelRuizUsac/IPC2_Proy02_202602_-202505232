@model ListaLibros
@{
    ViewData["Title"] = "Libros";
    ListaCategorias categorias = (ListaCategorias)ViewData["Categorias"]!;
    int cantidad = 0;
    NodoListaLibro? contador = Model.Primero;
    while (contador != null) { cantidad++; contador = contador.Siguiente; }
}
<h1>Libros</h1>
<section class="mb-4" id="registrar"><h2>Registrar un libro</h2>
@if (categorias.Primero == null) { <p class="notice">Primero <a asp-action="Categorias">crea una categoría</a> o importa un catálogo XML.</p> }
else {
<form asp-action="RegistrarLibro" method="post" class="d-grid gap-2 col-md-6"><label for="isbn">ISBN</label><input class="form-control" id="isbn" name="isbn" required inputmode="numeric" /><label for="titulo">Título</label><input class="form-control" id="titulo" name="titulo" required /><label for="autor">Autor</label><input class="form-control" id="autor" name="autor" required /><label for="categoria">Categoría</label><select class="form-select" id="categoria" name="nombreCategoria" required><partial name="_OpcionesCategorias" model="categorias" /></select><button class="btn btn-primary" type="submit">Guardar libro</button></form>
}</section>
<section class="mb-4"><div class="section-head"><div><h2>Libros registrados: @cantidad</h2></div><div class="d-flex flex-wrap gap-3 mb-3"><a asp-action="Menor">Menor ISBN</a><a asp-action="Mayor">Mayor ISBN</a><a asp-action="ReporteLibros" target="_blank" rel="noopener">Ver gráfico</a></div></div>
<div class="searches"><form asp-action="BuscarLibro" method="get" class="mb-3 col-md-6"><label for="buscar-isbn">Buscar por ISBN</label><div class="input-group"><input class="form-control" id="buscar-isbn" name="isbn" inputmode="numeric" /><button class="btn btn-primary" type="submit">Buscar</button></div></form><form asp-action="BuscarTitulo" method="get" class="mb-3 col-md-6"><label for="buscar-titulo">Buscar por título exacto</label><div class="input-group"><input class="form-control" id="buscar-titulo" name="titulo" /><button class="btn btn-primary" type="submit">Buscar</button></div></form></div>
<partial name="_Libros" model="Model" />
</section>
