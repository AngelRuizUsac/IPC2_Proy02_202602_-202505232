<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Catálogo de libros</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
</head>
<body class="container py-3">
    <header class="mb-4">
        <nav class="d-flex flex-wrap gap-3" aria-label="Navegación principal">
            <a asp-controller="Catalogo" asp-action="Index">Libros</a>
            <a asp-controller="Catalogo" asp-action="Categorias">Categorías</a>
            <a asp-controller="Catalogo" asp-action="Carga">Carga</a>
            <a asp-controller="Catalogo" asp-action="Ayuda">Ayuda</a>
        </nav>
    </header>
    <main id="contenido">
        @if (ViewData["Alerta"] is string alerta)
        {
            <div class="alert alert-warning" role="alert"><strong>Aviso</strong><p>@alerta</p></div>
        }
        @RenderBody()
    </main>
</body>
</html>
